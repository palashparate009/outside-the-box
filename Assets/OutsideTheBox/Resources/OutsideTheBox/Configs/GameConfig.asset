    fieldZones: 0
    tutorialSteps:
    - id: 301
      title: Switch polarity
      body: Use the PULL / PUSH button to change the magnetic force. Pull brings
        the ball closer; push drives it away and uses more energy while active.
      buttonLabel: TRY POLARITY
      completionTooltip: Switch polarity whenever the route needs it
    backgroundColorA: {r: 0.105, g: 0.07, b: 0.23, a: 1}
