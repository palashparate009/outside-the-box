    fieldZones: 0
    tutorialSteps:
    - id: 201
      title: Slippery floor
      body: The frozen glass has very little friction. Release the magnet early and
        use short pulls so the ball does not overshoot.
      buttonLabel: GOT IT
      completionTooltip: Short pulls give you more control
    backgroundColorA: {r: 0.035, g: 0.14, b: 0.28, a: 1}
